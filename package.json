{
  "name": "vuon-chung",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5240",
    "build": "tsc --noEmit && tsc -p tsconfig.sw.json && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json && tsc -p functions/tsconfig.json",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "test:rules": "firebase emulators:exec --only firestore --project demo-vuon-chung \"vitest run --config vitest.rules.config.ts\"",
    "test:shared": "firebase emulators:exec --only auth,firestore,database --project demo-vuon-chung \"playwright test --project shared --workers=1\"",
    "build:functions": "esbuild functions/src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=functions/lib/index.js --external:firebase-functions --external:firebase-admin"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.53.1",
    "@types/three": "^0.170.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.4",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "license": "MIT",
  "author": "Nguyen Quang Phu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pdz1804/vuon-chung.git"
  },
  "description": "A cozy two-player 3D farming game."
}
