{
  "rules": {
    "worlds": {
      "$world": {
        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['x', 'y', 'f', 't']) && newData.child('x').isNumber() && newData.child('y').isNumber()"
          }
        }
      }
    }
  }
}
