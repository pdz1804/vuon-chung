{
  "rules": {
    "worlds": {
      "$world": {
        "presence": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['x', 'y', 'f', 't']) && newData.child('x').isNumber() && newData.child('y').isNumber()",
            "e": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "et": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": "$other === 'x' || $other === 'y' || $other === 'f' || $other === 'm' || $other === 't'"
            }
          }
        }
      }
    }
  }
}
